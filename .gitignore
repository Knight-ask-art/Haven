# Dependencies and generated output
**/node_modules/
**/dist/
**/dist-ssr/
**/build/
**/out/
**/coverage/
**/target/
**/.vite/
**/.cache/
**/*.tsbuildinfo
**/__pycache__/
**/*.pyc

# Logs and temporary files
**/logs/
**/tmp/
**/.tmp/
.superpowers/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local configuration and secrets
.env
.env.*
!.env.example
*.local
*.pem
*.key
*.p12
*.pfx
*.bak
*.tmp

# Project-local coding-agent instructions and skills; keep out of public source.
/.agents/

# Local runtime data
*.db
*.db-*
*.sqlite
*.sqlite3

# Local research material and extracted third-party artifacts
参考项目/

# Local test/design material (kept on developer machines, never tracked)
/测试/*

# Product unit/integration tests are public source and are checked by CI. Keep
# local-only diagnostics and upstream demo tests out of the public snapshot.
/后端/crates/haven-infrastructure/tests/metadata_sources_live_diagnostic.rs
/后端/crates/haven-infrastructure/tests/opds_live_diagnostic.rs
/前端/app/src/spike/foliate/foliate-js/tests/
/前端/app/public/test-*.epub

# Local diagnostics and test output (including files without a .log suffix).
**/diagnostics/
**/diagnostic/
**/*.out
**/*.trace
**/*.dump
**/*.har

# Local planning material (kept on developer machines, never committed)
plan/

# Public documentation is allowed in ``docs/``. Keep raw project tracking and
# review/planning material local; publish only their maintained index files.
/docs/internal/
/docs/private/
/docs/aegis/
# Development operating procedures are private, not product documentation.
/docs/agents/
/docs/architecture/CLAUDE_CODE_AGENT_WORKFLOW.md
/docs/plans/*
!/docs/plans/README.md
/docs/reviews/*
!/docs/reviews/README.md
# Legacy superpowers material is local-only; canonical extracts belong under
# the maintained public documentation areas. Keep the directory ignored so no
# legacy execution files are added to the public snapshot.
/docs/superpowers/
/docs/drafts/
/docs/project/
/docs/tmp/
/docs/.tmp/

# Haven v0.1.0 is a Windows desktop release; mobile icon bundles are not
# generated or distributed with the public source snapshot.
/src-tauri/icons/android/
/src-tauri/icons/ios/

# Public release curation: source maps stay local.
**/*.map

# Generated at release time by the release workflow; the tracked
# src-tauri/tauri.conf.json remains the local-build source of truth.
/src-tauri/tauri.release.conf.json

# Internal-only helper documentation is not part of the public release snapshot.
**/AGENTS.md
/design-qa.md
/后端/README.md
/tools/README.md

# Design references and one-off local authoring notes are not runtime assets.
/前端/设计原则/
/前端/tokens-setup/
/前端/前端开发要求.txt
/前端/前端开发要点.txt
/前端/app/update_rules.py


# Disposable Cargo target cache for isolated verification.
.target-review-tests/

# Haven MCP 运行时：由 `tools/mcp/assemble-runtime.ps1` 组装进 Tauri 的 bundle resources。
# 只有那份占位 README 与 `tauri.conf.json` 的声明进 Git——二进制、编译产物与依赖都不进。
# 删掉这些规则会让一次 `tauri build` 之后的 Node 运行时被提交进仓库。
src-tauri/resources/haven-mcp/runtime/
src-tauri/resources/haven-mcp/dist/
src-tauri/resources/haven-mcp/node_modules/
src-tauri/resources/haven-mcp/package.json
src-tauri/resources/haven-mcp/haven-mcp-launcher.cmd
src-tauri/resources/*.manifest.json

# Editors and operating systems
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
