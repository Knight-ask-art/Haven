        "ci": ["FTV-LCL-FE-FIXTURES-001", "FTV-LCL-FE-FOCUS-001", "FTV-LCL-RUST-FIXTURES-001", "FTV-LCL-RUST-DOWNLOAD-001", "FTV-LCL-TAURI-RESOURCE-001"]
