      "acceptanceStatus": "not-accepted",
      "requiredChecks": {
        "local": ["FTV-LCL-FIXTURE-SOURCE-001", "FTV-LCL-FE-FOCUS-001", "FTV-LCL-RUST-IMPORT-001", "FTV-LCL-RUST-IMPORT-INTEGRATION-001", "FTV-LCL-COMMON-NETWORK-001", "FTV-LCL-RUST-STREAM-001", "FTV-LCL-TAURI-STREAM-001", "FTV-LCL-TAURI-RESOURCE-001"],
        "ci": ["FTV-LCL-FIXTURE-SOURCE-001", "FTV-LCL-FE-FOCUS-001", "FTV-LCL-RUST-IMPORT-001", "FTV-LCL-RUST-IMPORT-INTEGRATION-001", "FTV-LCL-COMMON-NETWORK-001", "FTV-LCL-RUST-STREAM-001", "FTV-LCL-TAURI-STREAM-001", "FTV-LCL-TAURI-RESOURCE-001"]
      },
      "requiredScenarios": ["FTV-RUN-PLAY-001", "FTV-RUN-PLAY-002", "FTV-RUN-PLAY-003", "FTV-RUN-PLAY-004", "FTV-RUN-PLAY-005", "FTV-REL-PLAY-001"]
    },
    {
