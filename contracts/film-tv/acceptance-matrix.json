{
  "schemaVersion": 1,
  "product": "Haven",
  "feature": "film-tv",
  "branch": "codex/film-tv-optimization",
  "principle": "构建和部署只能证明制品或部署动作，不得单独证明影视功能可用。",
  "completionRule": {
    "capabilityPassRequires": ["local", "ci", "runtime", "release"],
    "buildIsNotAcceptanceFor": ["local", "ci", "runtime", "release"],
    "deploymentIsNotAcceptanceFor": ["local", "ci", "runtime", "release"],
    "allowedStatuses": ["not-accepted", "partial", "pass", "fail", "blocked"]
  },
  "layers": {
    "local": {
      "purpose": "在开发机上验证类型、契约、协议、状态机和安全边界的确定性检查。",
      "passRule": "所有声明为本地必需的检查均有本次执行结果，并记录 HEAD SHA 与当前工作树指纹；构建结果单独记录，不得替代功能检查。",
      "owner": "开发者",
      "freshness": "每次进入评审前重新执行"
    },
    "ci": {
      "purpose": "在干净 Windows runner 中重复关键影视检查，并留下可下载的运行摘要。",
      "passRule": "影视专项检查必须是 CI 的独立步骤且退出码为 0；生成器必须在 GITHUB_ACTIONS=true 上下文中写入真实 GitHub Actions run ID 与工作树指纹，最终还要核对 job/artifact 与目标 commit；不能只引用 build/clippy 的结果。",
      "owner": "CI",
      "freshness": "每个相关 commit 或 pull request"
    },
    "runtime": {
      "purpose": "使用版本固定、可控、脱敏的测试源验证桌面应用真实调用链和失败恢复。",
      "passRule": "目标候选应用在指定环境逐项完成场景，并记录候选对象 SHA-256；浏览器 Mock、单元测试和部署成功均不能替代。",
      "owner": "验收执行人",
      "freshness": "候选包、关键网络策略或播放器链路变化后重新执行"
    },
    "release": {
      "purpose": "确认候选包、候选配置、运行时结果、迁移兼容和回滚路径，然后单独记录是否启用。",
      "passRule": "必须引用 local/ci/runtime 证据，记录候选对象与候选制品哈希、可用且已演练的回滚材料和启用状态。构建或部署成功本身不构成 release pass。",
      "owner": "发布负责人",
      "freshness": "每个候选发布版本"
    }
  },
  "checks": [
    {
      "id": "FTV-LCL-FIXTURE-SOURCE-001",
      "layers": ["local", "ci"],
      "kind": "command",
      "cwd": ".",
      "argv": ["python", "-B", "tools/film-tv/fixture_server.py", "--check"],
      "purpose": "启动并自测固定版本 loopback fixture 的 CMS10/M3U、HLS、字幕、Range、失败和重定向输入；不生成 runtime PASS。",
      "covers": ["source_protocols", "playback_hls", "proxy_security", "subtitles"]
    },
    {
      "id": "FTV-LCL-FE-FIXTURES-001",
      "layers": ["local", "ci"],
      "kind": "command",
      "cwd": "前端/app",
      "argv": ["npm", "run", "fixtures:check"],
      "purpose": "实际编译并运行脱敏 IPC fixture guard。",
      "covers": ["multi_source_search", "source_protocols", "work_identity", "playback_progress", "local_cache", "offline_download"]
    },
    {
      "id": "FTV-LCL-FE-FOCUS-001",
      "layers": ["local", "ci"],
      "kind": "command",
      "cwd": "前端/app",
      "argv": [
        "npm", "run", "test", "--", "--run",
        "src/features/search/ipc/search-gateway.test.ts",
        "src/features/search/lib/search-runtime-state.test.ts",
        "src/features/media/lib/edition-mapper.test.ts",
        "src/features/media/lib/work-detail-mapper.test.ts",
        "src/features/player/lib/playback-format-matrix.test.ts",
        "src/features/player/lib/playback-media-error.test.ts",
        "src/features/player/lib/player-runtime-state.test.ts",
        "src/features/player/lib/video-progress-controller.test.ts",
        "src/features/progress/ipc/progress-gateway.test.ts",
        "src/features/downloads/ipc/download-gateway.test.ts",
        "src/features/downloads/lib/download-error.test.ts",
        "src/features/downloads/lib/download-event-state.test.ts",
        "src/features/downloads/lib/downloads-runtime-state.test.ts",
        "src/features/settings/lib/source-catalog.test.ts"
      ],
      "purpose": "验证影视入口相关的前端状态、映射、播放错误、进度和下载行为。",
      "covers": ["multi_source_search", "source_protocols", "work_identity", "playback_hls", "playback_progress", "local_cache", "offline_download"]
    },
    {
      "id": "FTV-LCL-FE-SUBTITLE-001",
      "layers": ["local", "ci"],
      "kind": "command",
      "cwd": "前端/app",
      "argv": [
        "npm", "run", "test", "--", "--run",
        "src/features/player/lib/subtitle-converter.test.ts",
        "src/features/player/lib/subtitle-track-runtime.test.ts",
        "src/features/player/lib/subtitle-options.test.ts",
        "src/features/player/lib/playback-format-matrix.test.ts",
        "src/features/session/ipc/session-gateway.test.ts",
        "src/features/session/ipc/resource-fetch.test.ts"
      ],
      "purpose": "验证字幕 DTO/资源 URI 校验、SRT/VTT/SBV 归一化、HLS/外挂轨道映射、恶意标记隔离、预算和对象 URL 生命周期。",
      "covers": ["subtitles"]
    },
    {
      "id": "FTV-LCL-RUST-FIXTURES-001",
      "layers": ["local", "ci"],
      "kind": "command",
      "cwd": ".",
      "argv": ["cargo", "test", "--manifest-path", "后端/Cargo.toml", "-p", "haven-application", "--test", "fixtures_consistency", "--locked"],
      "purpose": "验证 Rust Wire DTO 与共享 fixture 的反序列化和语义一致性。",
      "covers": ["multi_source_search", "source_protocols", "work_identity", "playback_progress", "local_cache", "offline_download"]
    },
    {
      "id": "FTV-LCL-RUST-SEARCH-001",
      "layers": ["local", "ci"],
      "kind": "command",
      "cwd": ".",
      "argv": ["cargo", "test", "--manifest-path", "后端/Cargo.toml", "-p", "haven-application", "--lib", "search_source", "--locked"],
      "purpose": "验证多源并发、部分失败、取消、终态和候选索引行为。",
      "covers": ["multi_source_search"]
    },
    {
      "id": "FTV-LCL-RUST-SOURCE-001",
      "layers": ["local", "ci"],
      "kind": "command",
      "cwd": ".",
      "argv": ["cargo", "test", "--manifest-path", "后端/Cargo.toml", "-p", "haven-application", "--lib", "source_registry", "--locked"],
      "purpose": "验证来源目录、端点配置、启用状态和来源策略的已有合同。",
      "covers": ["source_protocols", "proxy_security"]
    },
    {
      "id": "FTV-LCL-COMMON-NETWORK-001",
      "layers": ["local", "ci"],
      "kind": "command",
      "cwd": ".",
      "argv": ["cargo", "test", "--manifest-path", "后端/Cargo.toml", "-p", "haven-common", "--lib", "network", "--locked"],
      "purpose": "验证来源端点、媒体流和受控代理共享的 URL、主机、端口及字面量地址策略。",
      "covers": ["source_protocols", "playback_hls", "proxy_security"]
    },
    {
      "id": "FTV-LCL-RUST-IMPORT-001",
      "layers": ["local", "ci"],
      "kind": "command",
      "cwd": ".",
      "argv": ["cargo", "test", "--manifest-path", "后端/Cargo.toml", "-p", "haven-application", "--lib", "source_import", "--locked"],
      "purpose": "验证来源候选、作品身份、集数归一化和媒体资源映射。",
      "covers": ["source_protocols", "work_identity", "playback_hls"]
    },
    {
      "id": "FTV-LCL-RUST-IMPORT-INTEGRATION-001",
      "layers": ["local", "ci"],
      "kind": "command",
      "cwd": ".",
      "argv": ["cargo", "test", "--manifest-path", "后端/Cargo.toml", "-p", "haven-application", "--test", "source_import_integration", "--locked"],
      "purpose": "验证 M3U 成功导入的 Work→Edition→MediaItem→Resource 链、重复导入幂等，以及资源写入失败时整条事务回滚。",
      "covers": ["source_protocols", "work_identity", "playback_hls"]
    },
    {
      "id": "FTV-LCL-RUST-STREAM-001",
      "layers": ["local", "ci"],
      "kind": "command",
      "cwd": ".",
      "argv": ["cargo", "test", "--manifest-path", "后端/Cargo.toml", "-p", "haven-application", "--lib", "stream", "--locked"],
      "purpose": "验证受控流资源类型、MIME 和播放会话输入边界。",
      "covers": ["playback_hls", "proxy_security"]
    },
    {
      "id": "FTV-LCL-RUST-PROGRESS-001",
      "layers": ["local", "ci"],
      "kind": "command",
      "cwd": ".",
      "argv": ["cargo", "test", "--manifest-path", "后端/Cargo.toml", "-p", "haven-application", "--lib", "progress", "--locked"],
      "purpose": "验证进度 CAS、定位器兼容性和保存/读取领域服务。",
      "covers": ["playback_progress"]
    },
    {
      "id": "FTV-LCL-RUST-DOWNLOAD-001",
      "layers": ["local", "ci"],
      "kind": "command",
      "cwd": ".",
      "argv": ["cargo", "test", "--manifest-path", "后端/Cargo.toml", "-p", "haven-application", "--lib", "download", "--locked"],
      "purpose": "验证下载状态机、失败重试、原子完成和来源资源校验。",
      "covers": ["local_cache", "offline_download", "proxy_security"]
    },
    {
      "id": "FTV-LCL-TAURI-STREAM-001",
      "layers": ["local", "ci"],
      "kind": "command",
      "cwd": ".",
      "argv": ["cargo", "test", "--manifest-path", "src-tauri/Cargo.toml", "--locked", "stream_registry"],
      "purpose": "验证播放 grant、owner 绑定、HLS 主机学习和 token 生命周期。",
      "covers": ["playback_hls", "proxy_security"]
    },
    {
      "id": "FTV-LCL-TAURI-RESOURCE-001",
      "layers": ["local", "ci"],
      "kind": "command",
      "cwd": ".",
      "argv": ["cargo", "test", "--manifest-path", "src-tauri/Cargo.toml", "--locked", "resource_protocol"],
      "purpose": "验证 HLS 重写、Range、MIME、CORS、大小限制和受控资源 URI。",
      "covers": ["playback_hls", "proxy_security", "local_cache"]
    },
    {
      "id": "FTV-LCL-TAURI-PROGRESS-001",
      "layers": ["local", "ci"],
      "kind": "command",
      "cwd": ".",
      "argv": ["cargo", "test", "--manifest-path", "src-tauri/Cargo.toml", "--locked", "progress_save"],
      "purpose": "验证 Tauri 进度命令的 ID、CAS 冲突和不写入失败路径。",
      "covers": ["playback_progress"]
    }
  ],
  "capabilities": [
    {
      "id": "multi_source_search",
      "label": "多源搜索",
      "acceptanceStatus": "not-accepted",
      "requiredChecks": {
        "local": ["FTV-LCL-FE-FIXTURES-001", "FTV-LCL-FE-FOCUS-001", "FTV-LCL-RUST-FIXTURES-001", "FTV-LCL-RUST-SEARCH-001"],
        "ci": ["FTV-LCL-FE-FIXTURES-001", "FTV-LCL-FE-FOCUS-001", "FTV-LCL-RUST-FIXTURES-001", "FTV-LCL-RUST-SEARCH-001"]
      },
      "requiredScenarios": ["FTV-RUN-SEARCH-001", "FTV-RUN-SEARCH-002", "FTV-RUN-SEARCH-003", "FTV-RUN-SEARCH-004", "FTV-REL-SEARCH-001"]
    },
    {
      "id": "source_protocols",
      "label": "来源协议",
      "acceptanceStatus": "not-accepted",
      "requiredChecks": {
        "local": ["FTV-LCL-FIXTURE-SOURCE-001", "FTV-LCL-FE-FIXTURES-001", "FTV-LCL-FE-FOCUS-001", "FTV-LCL-RUST-FIXTURES-001", "FTV-LCL-RUST-SOURCE-001", "FTV-LCL-COMMON-NETWORK-001", "FTV-LCL-RUST-IMPORT-001", "FTV-LCL-RUST-IMPORT-INTEGRATION-001"],
        "ci": ["FTV-LCL-FIXTURE-SOURCE-001", "FTV-LCL-FE-FIXTURES-001", "FTV-LCL-FE-FOCUS-001", "FTV-LCL-RUST-FIXTURES-001", "FTV-LCL-RUST-SOURCE-001", "FTV-LCL-COMMON-NETWORK-001", "FTV-LCL-RUST-IMPORT-001", "FTV-LCL-RUST-IMPORT-INTEGRATION-001"]
      },
      "requiredScenarios": ["FTV-RUN-SOURCE-001", "FTV-RUN-SOURCE-002", "FTV-RUN-SOURCE-003", "FTV-RUN-SOURCE-004", "FTV-REL-SOURCE-001"]
    },
    {
      "id": "work_identity",
      "label": "作品身份",
      "acceptanceStatus": "not-accepted",
      "requiredChecks": {
        "local": ["FTV-LCL-FE-FIXTURES-001", "FTV-LCL-FE-FOCUS-001", "FTV-LCL-RUST-FIXTURES-001", "FTV-LCL-RUST-IMPORT-001", "FTV-LCL-RUST-IMPORT-INTEGRATION-001"],
        "ci": ["FTV-LCL-FE-FIXTURES-001", "FTV-LCL-FE-FOCUS-001", "FTV-LCL-RUST-FIXTURES-001", "FTV-LCL-RUST-IMPORT-001", "FTV-LCL-RUST-IMPORT-INTEGRATION-001"]
      },
      "requiredScenarios": ["FTV-RUN-IDENTITY-001", "FTV-RUN-IDENTITY-002", "FTV-RUN-IDENTITY-003", "FTV-REL-IDENTITY-001"]
    },
