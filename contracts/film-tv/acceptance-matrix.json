      },
      "requiredScenarios": ["FTV-RUN-DOWNLOAD-001", "FTV-RUN-DOWNLOAD-002", "FTV-RUN-DOWNLOAD-003", "FTV-RUN-DOWNLOAD-004", "FTV-RUN-DOWNLOAD-005", "FTV-REL-DOWNLOAD-001"]
    }
  ],
  "scenarios": [
    {"id": "FTV-RUN-SEARCH-001", "layer": "runtime", "capability": "multi_source_search", "name": "多个受控来源成功并按作品身份合并", "requiredObservation": "同一作品只出现一个稳定 Work，保留来源与播放组映射。"},
    {"id": "FTV-RUN-SEARCH-002", "layer": "runtime", "capability": "multi_source_search", "name": "单来源失败仍返回部分结果", "requiredObservation": "失败源有稳定错误码，成功源结果可继续消费。"},
    {"id": "FTV-RUN-SEARCH-003", "layer": "runtime", "capability": "multi_source_search", "name": "来源超时和用户取消", "requiredObservation": "底层任务停止或进入明确终态，不能无限等待。"},
    {"id": "FTV-RUN-SEARCH-004", "layer": "runtime", "capability": "multi_source_search", "name": "空结果、重复启动和事件顺序", "requiredObservation": "空结果与幂等启动可区分，事件 sequence 单调且终态唯一。"},
    {"id": "FTV-RUN-SOURCE-001", "layer": "runtime", "capability": "source_protocols", "name": "结构化来源协议解析", "requiredObservation": "JSON/CMS10 等协议映射为受控候选，不把原始 URL 当内部身份。"},
    {"id": "FTV-RUN-SOURCE-002", "layer": "runtime", "capability": "source_protocols", "name": "M3U 播放列表和剧集归一化", "requiredObservation": "分组、集号、标题和资源类型稳定，畸形行被隔离。"},
    {"id": "FTV-RUN-SOURCE-003", "layer": "runtime", "capability": "source_protocols", "name": "协议漂移与认证失败", "requiredObservation": "格式异常、超时、认证失败分别呈现，不污染其他来源。"},
    {"id": "FTV-RUN-SOURCE-004", "layer": "runtime", "capability": "source_protocols", "name": "来源配置迁移和禁用", "requiredObservation": "升级后端点不回传到 UI，禁用来源不参与搜索。"},
    {"id": "FTV-RUN-IDENTITY-001", "layer": "runtime", "capability": "work_identity", "name": "稳定外部 ID 合并同作", "requiredObservation": "稳定外部 ID 优先，来源播放地址作为 Resource 而非 Work 身份。"},
    {"id": "FTV-RUN-IDENTITY-002", "layer": "runtime", "capability": "work_identity", "name": "同名异作不误合并", "requiredObservation": "年份、类型、外部 ID 冲突时保留不同 Work。"},
    {"id": "FTV-RUN-IDENTITY-003", "layer": "runtime", "capability": "work_identity", "name": "季集和版本映射", "requiredObservation": "Edition/MediaItem/Resource 层级可追溯，切集不会串资源。"},
