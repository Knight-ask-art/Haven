      "acceptanceStatus": "not-accepted",
      "requiredChecks": {
        "local": ["FTV-LCL-FIXTURE-SOURCE-001", "FTV-LCL-RUST-SOURCE-001", "FTV-LCL-COMMON-NETWORK-001", "FTV-LCL-RUST-STREAM-001", "FTV-LCL-RUST-DOWNLOAD-001", "FTV-LCL-TAURI-STREAM-001", "FTV-LCL-TAURI-RESOURCE-001"],
        "ci": ["FTV-LCL-FIXTURE-SOURCE-001", "FTV-LCL-RUST-SOURCE-001", "FTV-LCL-COMMON-NETWORK-001", "FTV-LCL-RUST-STREAM-001", "FTV-LCL-RUST-DOWNLOAD-001", "FTV-LCL-TAURI-STREAM-001", "FTV-LCL-TAURI-RESOURCE-001"]
      },
      "requiredScenarios": ["FTV-RUN-SEC-001", "FTV-RUN-SEC-002", "FTV-RUN-SEC-003", "FTV-RUN-SEC-004", "FTV-RUN-SEC-005", "FTV-REL-SEC-001"]
