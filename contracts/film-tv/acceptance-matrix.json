        "ci": ["FTV-LCL-FE-FIXTURES-001", "FTV-LCL-FE-FOCUS-001", "FTV-LCL-RUST-FIXTURES-001", "FTV-LCL-RUST-PROGRESS-001", "FTV-LCL-TAURI-PROGRESS-001"]
      },
      "requiredScenarios": ["FTV-RUN-PROGRESS-001", "FTV-RUN-PROGRESS-002", "FTV-RUN-PROGRESS-003", "FTV-RUN-PROGRESS-004", "FTV-RUN-PROGRESS-005", "FTV-REL-PROGRESS-001"]
    },
