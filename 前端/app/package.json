{
  "name": "app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/write-build-info.mjs",
    "test": "vitest run",
    "lint": "oxlint",
    "preview": "vite preview",
    "governance:check": "node scripts/governance-audit.js",
    "fixtures:check": "node scripts/fixtures-check-runner.mjs",
    "film-tv:contract": "python ../../tools/film-tv/evidence-check.py --layer contract",
    "film-tv:local": "python ../../tools/film-tv/evidence-check.py --layer local --output ../../测试/film-tv/evidence/local.json",
    "ci:check": "npm run lint && npm run governance:check && npm run fixtures:check && npm run film-tv:contract && npm run test && npm run build"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.17",
    "hls.js": "^1.7.3",
    "lucide-react": "^1.58.0",
    "motion": "^14.3.0",
    "pdfjs-dist": "^6.4.299",
    "pinyin-pro": "3.29.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "^8.4.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "jsdom": "^30.1.3",
    "oxlint": "^1.88.0",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
